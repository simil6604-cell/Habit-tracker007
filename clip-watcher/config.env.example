# Kopieren nach config.env und ausfüllen. config.env wird NICHT ins Git übernommen.
THRESHOLD=75
MAX_PER_DAY=5
DRY_RUN=1
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_PRIVACY=public
PLATFORMS=YouTube,TikTok,Instagram
# TikTok (developers.tiktok.com, Produkt "Content Posting API" mit Direct Post)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
TIKTOK_PRIVACY=SELF_ONLY
# Instagram (developers.facebook.com, App mit "Instagram API with Instagram login")
IG_APP_ID=
IG_APP_SECRET=
IG_USER_ID=
IG_ACCESS_TOKEN=
# Für auth.py: genau so in TikTok- und Instagram-App eingetragen (https)
REDIRECT_URI=
