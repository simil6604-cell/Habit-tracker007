// Personal Optimization App — data model
// Dev uses SQLite (file-based, zero external setup). Swapping to Postgres for
// production is a one-line change: set provider = "postgresql" and DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth / User ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())

  onboardingComplete Boolean @default(false)
  optimizeSchool     Boolean @default(true)
  optimizeGym        Boolean @default(true)
  optimizeFootball   Boolean @default(true)
  // Where the user puts most of their effort right now — the coach leans this
  // way when the three areas compete for the same hours.
  mainFocus          String  @default("balanced") // school | gym | football | balanced
  theme              String  @default("system") // light | dark | system

  // When this account last downloaded a backup. Stored so the app can say how
  // old the only copy of your data is — a safety net nobody remembers to use
  // is not a safety net.
  lastBackupAt DateTime?

  weightKg          Int? // current weight; used to estimate calories burned
  targetWeightKg    Int? // your own goal — the app never invents or suggests this
  dailyCalorieGoal  Int? // optional, user-set; the app never invents this
  dailyProteinGoalG Int  @default(150) // your own goal; used by the weekly meal plan
  dailyCarbsGoalG   Int  @default(250) // your own goal
  dailyFatGoalG     Int  @default(70) // your own goal
  dailyWaterGoalMl  Int  @default(2000) // your own goal

  weightLogs      BodyWeightLog[]
  bodyPhotos      BodyPhoto[]
  scannedProducts ScannedProduct[]
  waterLogs       WaterLog[]

  accounts Account[]
  sessions Session[]

  school             School?
  subjects           Subject[]
  homework           Homework[]
  exams              Exam[]
  studySessions      StudySession[]
  flashcards         Flashcard[]
  workouts           Workout[]
  workoutSessions    WorkoutSession[]
  meals              Meal[]
  footballProfile    FootballProfile?
  goals              Goal[]
  tasks              Task[]
  calendarEvents     CalendarEvent[]
  recommendations    AIRecommendation[]
  progressEntries    Progress[]
  chatMessages       ChatMessage[]
  schoolAIMessages   SchoolAIMessage[]
  assessments        Assessment[]
  schoolHabits       SchoolHabit[]
  learningLogEntries LearningLogEntry[]
  notePhotos         NotePhoto[]
  classRecordings    ClassRecording[]
  tutorMessages      TutorMessage[]
  drillVideos        DrillVideo[]
  schoolAIUploads    SchoolAIUpload[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- School ----------

model School {
  id              String  @id @default(cuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  educationSystem String // IGCSE | AS_LEVEL | A_LEVEL | OTHER
  yearGroup       String?
}

model Subject {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name               String
  color              String   @default("#6366f1")
  teacher            String?
  room               String?
  isExamSubject      Boolean  @default(false) // e.g. IGCSE/A-Level subjects — highlighted on the timetable
  // Per-subject qualification level: a student can sit IGCSE Core Maths and
  // A Level Economics side by side, and the AI must pitch each accordingly.
  level              String? // IGCSE_CORE | IGCSE_EXTENDED | AS_LEVEL | A_LEVEL | OTHER
  baselineConfidence Int? // 0-100, from the initial "where do you stand" assessment
  // A revision site you work from for this subject (Save My Exams, Physics &
  // Maths Tutor, your school's own portal...). Stored as a link only: the app
  // never fetches or copies the site's content, it just puts the page one tap
  // away and tells the AI which material you're revising from.
  revisionUrl        String?
  createdAt          DateTime @default(now())

  topics         Topic[]
  timetableSlots TimetableSlot[]
  homework       Homework[]
  exams          Exam[]
  studySessions  StudySession[]
  flashcards     Flashcard[]

  @@index([userId])
}

model TimetableSlot {
  id         String   @id @default(cuid())
  subjectId  String?
  subject    Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  userId     String
  dayOfWeek  Int // 0=Monday .. 6=Sunday
  startTime  String // "08:00"
  endTime    String // "09:00"
  label      String? // e.g. "Break", "Lunch", or free lesson note
  room       String?
  isFree     Boolean  @default(false)
  periodName String? // e.g. "P1", "AM Regs", "Lunch" — shown as the row header on the timetable diagram
  periodType String   @default("LESSON") // REGISTRATION | LESSON | BREAK | LUNCH | STUDY | CLUB | FREE
  highlight  Boolean  @default(false) // manual highlight override (e.g. for clubs with no subject)

  @@index([userId, dayOfWeek])
}

model Topic {
  id              String             @id @default(cuid())
  subjectId       String
  subject         Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name            String
  parentTopic     String? // subtopic grouping label
  progressPct     Int                @default(0)
  priority        String             @default("MEDIUM") // LOW | MEDIUM | HIGH
  examRelevance   String             @default("MEDIUM")
  plannedMinutes  Int                @default(0)
  actualMinutes   Int                @default(0)
  nextReview      DateTime?
  weaknessNote    String?
  // The revision page for this specific topic. Falls back to the subject's
  // link when unset, so there is always somewhere to go.
  revisionUrl     String?
  learningLog     LearningLogEntry[]
  notePhotos      NotePhoto[]
  classRecordings ClassRecording[]
  tutorMessages   TutorMessage[]

  @@index([subjectId])
}

// A real, persisted back-and-forth conversation with the AI tutor for one
// topic — not a one-shot Q&A. Each turn is stored so the AI sees the whole
// conversation so far, the way a real tutoring session builds on itself.
model TutorMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  role      String // USER | ASSISTANT
  content   String
  createdAt DateTime @default(now())

  @@index([topicId, createdAt])
}

// A photo of handwritten/printed notes for a topic. imagePath is the photo
// as uploaded, stored as-is; summary is a real AI transcription/summary of
// it when a real AI is connected — null (not invented) otherwise.
model NotePhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  imagePath String
  summary   String?
  createdAt DateTime @default(now())

  @@index([topicId])
  // The setup card reads every photo this user owns; without this that is a
  // full table scan on a page anyone can open.
  @@index([userId])
}

// A transcript captured live in class via the browser's own speech-to-text
// (or pasted in by hand where that's unsupported), plus a real AI summary
// once one's generated. The transcript itself is exactly what was
// recognized/typed — never invented.
model ClassRecording {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  transcript String
  summary    String?
  createdAt  DateTime @default(now())

  @@index([topicId])
}

// The student's own running log while learning a topic with the AI: what
// they understand, what they don't, and what they're still asking about.
// Feeds the end-of-session quiz so it targets the actual gaps.
model LearningLogEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type      String // UNDERSTOOD | CONFUSED | QUESTION
  content   String
  createdAt DateTime @default(now())

  @@index([topicId, type])
}

model Homework {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title       String
  description String?
  dueDate     DateTime
  status      String   @default("PENDING") // PENDING | DONE | MISSED
  createdAt   DateTime @default(now())

  @@index([userId, dueDate])
}

model Exam {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  title     String
  date      DateTime
  weight    String   @default("MEDIUM") // importance
  notes     String?

  @@index([userId, date])
}

model StudySession {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId   String?
  subject     Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topicLabel  String?
  start       DateTime
  end         DateTime
  completed   Boolean  @default(false)
  aiGenerated Boolean  @default(false)

  @@index([userId, start])
}

// A daily habit tracker grid, like a classic habit-tracker app: fixed
// recurring habits as rows, days as columns, checked off day by day.
model SchoolHabit {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  emoji     String?
  order     Int              @default(0)
  createdAt DateTime         @default(now())
  logs      SchoolHabitLog[]

  @@index([userId])
}

// One row per day a habit was checked off. Absence of a row = not done that
// day — no need to pre-fill "not done" rows for every day.
model SchoolHabitLog {
  id      String      @id @default(cuid())
  habitId String
  habit   SchoolHabit @relation(fields: [habitId], references: [id], onDelete: Cascade)
  date    DateTime // normalized to local midnight for that day

  @@unique([habitId, date])
  @@index([habitId, date])
}

model Flashcard {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId        String?
  subject          Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  topic            String?
  front            String
  back             String
  // Simple SM-2-style spaced repetition state
  interval         Int      @default(1) // days
  easeFactor       Float    @default(2.5)
  repetitions      Int      @default(0)
  dueDate          DateTime @default(now())
  lastResult       String? // AGAIN | HARD | GOOD | EASY
  createdAt        DateTime @default(now())
  // The learning-log entry this card was generated from, when it came from
  // something you marked as not understood. Kept so a second "generate" pass
  // doesn't make a duplicate card for the same confusion, and so the card can
  // say where it came from. Null for cards you wrote yourself.
  sourceLogEntryId String?

  @@index([userId, dueDate])
  @@index([userId, sourceLogEntryId])
}

// ---------- Gym ----------

model Workout {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String // e.g. "Upper Body"
  dayOfWeek Int?
  exercises Exercise[]
  sessions  WorkoutSession[]
  createdAt DateTime         @default(now())

  @@index([userId])
}

model Exercise {
  id           String   @id @default(cuid())
  workoutId    String
  workout      Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name         String
  targetSets   Int      @default(3)
  targetReps   Int      @default(10)
  targetWeight Float?
  order        Int      @default(0)
  cueText      String? // short "how to" reminder, from the curated library or your own
  videoUrl     String? // a video YOU save/paste — the app never invents or fetches one
  setLogs      SetLog[]
}

model WorkoutSession {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workoutId      String?
  workout        Workout? @relation(fields: [workoutId], references: [id], onDelete: SetNull)
  date           DateTime @default(now())
  completed      Boolean  @default(false)
  durationMin    Int?
  difficulty     String? // EASY | MODERATE | HARD
  caloriesBurned Int? // rough MET-based estimate, computed at log time
  notes          String?
  wentWell       String? // training diary
  toImprove      String? // training diary
  setLogs        SetLog[]

  @@index([userId, date])
}

model SetLog {
  id         String         @id @default(cuid())
  sessionId  String
  session    WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId String
  exercise   Exercise       @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  setNumber  Int
  reps       Int
  weight     Float
  isPB       Boolean        @default(false)
}

model Meal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  type        String // BREAKFAST | LUNCH | DINNER | SNACK
  description String
  kcal        Int? // user-entered or picked from the common-foods list; always approximate
  proteinG    Int? // user-entered or picked from the common-foods list; always approximate
  carbsG      Int? // user-entered or picked from the common-foods list; always approximate
  fatG        Int? // user-entered or picked from the common-foods list; always approximate
  notes       String?
  imagePath   String? // a photo you took; the AI can estimate macros from it on request
  // True when the macros came from an AI estimate rather than a label or your
  // own entry, so the UI can say so instead of passing a guess off as measured.
  estimated   Boolean  @default(false)

  @@index([userId, date])
}

// A single water log entry — tapping a glass logs a fixed amount, always
// editable/removable. No estimated "water from food" — that would need a
// real food-composition database this app doesn't have.
model WaterLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountMl Int
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

model BodyPhoto {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  imagePath String
  caption   String?

  @@index([userId, date])
}

model ScannedProduct {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  barcode     String
  name        String?
  brand       String?
  imageUrl    String? // hotlinked from Open Food Facts, not stored locally
  nutriScore  String? // a-e, straight from Open Food Facts when available
  novaGroup   Int? // 1-4 processing level, straight from Open Food Facts when available
  healthScore Int // our own 0-100 score, computed from the above — see lib/gym/health-score.ts
  scannedAt   DateTime @default(now())

  @@index([userId, scannedAt])
}

model BodyWeightLog {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date     DateTime @default(now())
  weightKg Float

  @@index([userId, date])
}

model Goal {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    String // SCHOOL | GYM | FOOTBALL
  title       String
  targetDate  DateTime?
  progressPct Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// ---------- Football ----------

model FootballProfile {
  id         String        @id @default(cuid())
  userId     String        @unique
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  position   String // GK, CB, LB, RB, CM, CDM, CAM, LW, RW, ST
  strengths  String? // comma separated
  weaknesses String? // comma separated
  teamId     String?
  team       FootballTeam? @relation(fields: [teamId], references: [id], onDelete: SetNull)

  trainings FootballTraining[]
  matches   FootballMatch[]
}

model FootballTeam {
  id           String            @id @default(cuid())
  name         String
  league       String?
  dataSource   String            @default("MANUAL") // MANUAL | API
  sourceUrl    String? // pasted league-table page, when dataSource is API
  lastSyncedAt DateTime?
  profiles     FootballProfile[]
  standings    TeamStanding[]
}

model TeamStanding {
  id           String       @id @default(cuid())
  teamId       String
  team         FootballTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  season       String       @default("current")
  rank         Int
  teamName     String
  played       Int
  won          Int
  drawn        Int
  lost         Int
  goalsFor     Int
  goalsAgainst Int
  points       Int
  updatedAt    DateTime     @updatedAt

  @@index([teamId, season])
}

model FootballTraining {
  id            String          @id @default(cuid())
  profileId     String
  profile       FootballProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title         String
  dayOfWeek     Int?
  date          DateTime?
  durationMin   Int             @default(60)
  focus         String // e.g. "Technique", "Conditioning"
  drills        String // JSON-encoded list of {name, minutes, cueText?, videoUrl?}
  isTeamSession Boolean         @default(true)
  completed     Boolean         @default(false)
  wentWell      String? // training diary
  toImprove     String? // training diary

  @@index([profileId])
}

model FootballMatch {
  id           String          @id @default(cuid())
  profileId    String
  profile      FootballProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  opponent     String
  date         DateTime
  isHome       Boolean         @default(true)
  scoreFor     Int?
  scoreAgainst Int?
  notes        String?

  @@index([profileId, date])
}

// ---------- Cross-cutting ----------

model Task {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  description  String?
  category     String // SCHOOL | GYM | FOOTBALL | GENERAL
  subjectLabel String?
  priority     String    @default("MEDIUM") // LOW | MEDIUM | HIGH
  estimatedMin Int?
  status       String    @default("TODO") // TODO | IN_PROGRESS | DONE | MISSED
  dueDate      DateTime?
  recurrence   String? // NONE | DAILY | WEEKLY
  createdAt    DateTime  @default(now())

  @@index([userId, status])
}

model CalendarEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  category   String // SCHOOL | STUDY | GYM | FOOTBALL | EXAM | TASK | RECOVERY
  start      DateTime
  end        DateTime
  allDay     Boolean  @default(false)
  sourceType String? // e.g. "Homework", "Workout", "FootballTraining"
  sourceId   String?

  @@index([userId, start])
}

model AIRecommendation {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // BALANCE_WARNING | STUDY_PLAN | SCHEDULE_CHANGE | NUTRITION | FOOTBALL_DRILL
  title          String
  message        String
  reasoning      String // JSON-encoded list of reason strings ("Why?")
  proposedChange String? // JSON-encoded diff, null if purely informational
  status         String   @default("PENDING") // PENDING | ACCEPTED | DECLINED | INFO
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date        DateTime @default(now())
  schoolPct   Int      @default(0)
  gymPct      Int      @default(0)
  footballPct Int      @default(0)
  recoveryPct Int      @default(0)
  overallPct  Int      @default(0)

  @@unique([userId, date])
}

model Assessment {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     String // SCHOOL | GYM | FOOTBALL
  answers      String // JSON-encoded {label, value}[] self-ratings
  overallScore Int // 0-100 summary used as the starting baseline
  createdAt    DateTime @default(now())

  @@index([userId, category, createdAt])
}

/**
 * The School-only AI conversation.
 * Separate from ChatMessage, which is the coach that weighs school, gym and
 * football against each other. This one only ever talks about school, at the
 * student's own Cambridge level, and it is where photographed notes and past
 * papers are sent — so it needs somewhere to keep them with the question they
 * belong to.
 */
model DrillVideo {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The skill this is an example of, as named in FOOTBALL_SKILLS.
  skill  String
  // A link YOU paste. The app never invents one and never fetches the page —
  // the same rule the saved exercise and revision links follow.
  url    String
  // Your own note: "the one my coach showed us", "warm-up version".
  label     String?
  createdAt DateTime @default(now())

  @@index([userId, skill])
}

/**
 * A photo uploaded to the school AI but not yet attached to a question.
 *
 * It exists so the app can tell those files apart from every other photo in
 * the same directory. Without it, "discard this staged photo" could only check
 * that the path is under your own upload folder — which is also true of your
 * progress photos and your note photos — and a staged photo you never sent
 * could never be identified again, so it stayed on the disk forever.
 *
 * Rows live for hours, not for keeps: sending the question clears them, and a
 * sweep removes whatever was abandoned.
 */
model SchoolAIUpload {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  path      String
  createdAt DateTime @default(now())

  @@unique([userId, path])
  @@index([userId, createdAt])
}

model SchoolAIMessage {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String // USER | ASSISTANT
  content    String
  // The /uploads paths of any photos sent with this message, as JSON. A
  // question about three pages of a past paper is one message, not three.
  imagePaths String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // USER | ASSISTANT
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
